# ---- LLM (agents) ----
# ollama (local, default) | groq (cloud, free tier) | openai | none
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT=120

# ---- agents ----
WEB_SEARCH_ENABLED=true
MAX_CLAIMS=3
EVIDENCE_PER_CLAIM=4

# ---- serving ----
ALLOWED_ORIGINS=*
LOAD_TRANSFORMER=true     # set false on a <512MB host
LOAD_EMBED=true
VERIFACT_API_KEY=         # optional; when set, POST /feedback needs X-API-Key
DB_PATH=data/app.db
